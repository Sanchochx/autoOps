# Variables for scripts/provision/bootstrap.sh and verify.sh (US-PROV-001).
#
#   cp scripts/provision/provision.env.example provision.env   # outside the repo, or ignored by git
#   chmod 600 provision.env
#   sudo ./scripts/provision/bootstrap.sh --env-file provision.env
#   sudo ./scripts/provision/verify.sh    --env-file provision.env
#
# Format: NAME=value, one per line (quotes optional). The file is parsed, never executed. A variable
# already set in the environment takes precedence over this file. NO SECRETS HERE: it only holds
# paths and public settings. Application secrets live in ${APP_DIR}/.env.
# Commented lines show the default of each optional variable.

# --- Required ---------------------------------------------------------------------------
# Administrator account created/used for SSH and sudo (10_users, 20_ssh). Not root nor SERVICE_USER.
ADMIN_USER=
# Public ed25519 key (one line) installed for ADMIN_USER. Must be a .pub file, never the private key.
ADMIN_SSH_PUBKEY_FILE=
# IPs/CIDRs fail2ban never bans (admin IP and local network), separated by spaces or commas.
FAIL2BAN_IGNOREIP=

# --- Service account and deployment -----------------------------------------------------
#SERVICE_USER=autoops
#SERVICE_UID=1500
#SERVICE_GID=1500
# Directory with the deployed repository: docker-compose.yml and .env must exist before bootstrap.
#APP_DIR=/opt/autoops
#AUTOOPS_ENABLE=0                # 1 = enable autoops and the backup timer at boot (70_systemd)
#PWQUALITY_MINLEN=14

# --- SSH (20_ssh) -----------------------------------------------------------------------
# Default: sshd's effective port.
#SSH_PORT=
# bootstrap.sh lengthens the automatic rollback to 30 min so it does not fire mid-run.
#SSH_ROLLBACK_MINUTES=30
# CI/CD account: set the key AND the source IP/CIDR from which it may connect (both or neither).
#DEPLOY_USER=autoops-deploy
#DEPLOY_SSH_PUBKEY_FILE=
#DEPLOY_ALLOWED_FROM=

# --- fail2ban (30_fail2ban) -------------------------------------------------------------
#FAIL2BAN_MAXRETRY=3
#FAIL2BAN_FINDTIME=10m
#FAIL2BAN_BANTIME=1h
#FAIL2BAN_BANTIME_FACTOR=2
#FAIL2BAN_BANTIME_MAXTIME=1w

# --- Firewall (40_ufw, 45_docker_ufw) ---------------------------------------------------
# Restricts SSH to this IP/CIDR; empty = open to any source (rate limited).
#ADMIN_CIDR=
# Web TCP ports to open, space-separated. Default: PROXY_HTTP_PORT and PROXY_HTTPS_PORT from ${APP_DIR}/.env
# (what Traefik publishes; 80 and 443 when unset). Set it only to override that.
#UFW_WEB_PORTS=
# Host ports reachable from outside; default: PORT and FRONTEND_PORT from ${APP_DIR}/.env.
#DOCKER_PUBLIC_PORTS=
#DOCKER_EXT_IFACES=              # default: interfaces of the default route

# --- TLS (65_tls, US-PROXY-002) ---------------------------------------------------------
# TLS_MODE, DOMAIN, TLS_DIR and TLS_EXTRA_SANS (and, for acme, ACME_EMAIL and PUBLIC_SCHEME=https) are read from ${APP_DIR}/.env (docker compose needs them
# too); TLS_MODE has no default. Only the identity Traefik runs as is set here, and it must match
# `user:` of the traefik service in docker-compose.yml.
#TLS_PROXY_UID=65532
#TLS_PROXY_GID=65532

# --- OS baseline and Docker (50_os_baseline, 60_docker) ---------------------------------
#TIMEZONE=UTC
#AUTO_REBOOT_TIME=               # HH:MM; empty = never reboot automatically
#APT_UPGRADE=1
# Pin versions for reproducible hosts (empty = latest in the Docker repository).
#DOCKER_VERSION=
#DOCKER_CONTAINERD_VERSION=
#DOCKER_COMPOSE_VERSION=
#DOCKER_BUILDX_VERSION=

# --- verify.sh only ---------------------------------------------------------------------
# Extra TCP ports allowed to listen on non-loopback interfaces (default: SSH only). After deploying
# the stack, list the published ports, e.g. "8000 3000".
#EXPECTED_TCP_PORTS=
# 0 = skip the runtime checks (active unit, healthy services), e.g. before the first start.
#STACK_REQUIRED=1

# --- Backups (US-SYS-004) ---------------------------------------------------------------
# BACKUP_DIR, BACKUP_RETENTION_DAYS and BACKUP_SCHEDULE are NOT read from this file: 70_systemd.sh and
# the backup scripts read them from ${APP_DIR}/.env (see .env.example), e.g.
#   BACKUP_DIR=/opt/autoops/backups   BACKUP_RETENTION_DAYS=7   BACKUP_SCHEDULE="*-*-* 03:00:00"
