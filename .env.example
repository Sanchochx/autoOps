# ═══════════════════════════════════════════════════════════════
# AutoOps — Centralized environment variable template
# Usage: cp .env.example .env  (never commit .env)
# Rule: every new variable is added here in the same US that introduces it.
# ═══════════════════════════════════════════════════════════════

# ── Server & Gateway ─────────────────────────────────────────
# Consumed by: apps/api_gateway
# Local startup: python -m apps.api_gateway.run
# HOST: listen interface (127.0.0.1 in development; 0.0.0.0 in container)
HOST=127.0.0.1
# PORT: port the gateway listens on. Internal only: in Docker it is reachable just through Traefik
# (edge_net), never published on the host, and provisioning does not open it in the firewall.
PORT=8000
# CORS_ALLOWED_ORIGINS: allowed origins separated by commas (development: gateway run with
# uvicorn). Empty = no origin allowed (* is never used). Under Docker Compose it is not read:
# the stack allows only the public origin, ${PUBLIC_SCHEME}://${DOMAIN}.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
DEBUG=True
ENVIRONMENT=development
# JWT_SECRET: signs the access tokens. REQUIRED, no default, at least 32 characters: openssl rand -hex 32
# (replaces SECRET_KEY, which the gateway no longer reads; remove SECRET_KEY once the rollout is verified).
# JWT_TTL_MINUTES: access token lifetime (default 60). LOGIN_MAX_ATTEMPTS / LOGIN_WINDOW_SECONDS: failed logins
# allowed per client IP in the window (defaults 5 / 300 s). There are no user credentials in .env: create the first
# user with scripts/ops/create_user.sh (prompts for username and password).
JWT_SECRET=
#JWT_TTL_MINUTES=60
#LOGIN_MAX_ATTEMPTS=5
#LOGIN_WINDOW_SECONDS=300

# WS_BROADCAST_TIMEOUT_SECONDS: maximum time (s) to emit an AI event over
# WebSocket; prevents a slow client from holding the background task.
WS_BROADCAST_TIMEOUT_SECONDS=2

# PYTHONPATH: required to start the Gateway from the monorepo root.
# Must include the repo root (`apps` module) and `services/ai-engine` (module
# `ai_engine`, which the Gateway imports to load the graph). E.g. in development:
#   export PYTHONPATH=.:services/ai-engine
# In a container it is set with ENV in the Dockerfile / compose `environment:`.
PYTHONPATH=.:services/ai-engine

# ── PostgreSQL Database ───────────────────────────────────
# Consumed by: apps/api_gateway, services/mcp-servers (DB MCP server)
# The AI engine does NOT use these variables: it accesses the DB only via MCP.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=autoops_db
DB_USER=autoops_user
DB_PASSWORD=cambia_esta_clave
# Async connection string (SQLAlchemy + asyncpg). Consumed by: apps/api_gateway
# and Alembic (migrations). Must use the `postgresql+asyncpg`.
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/dbname

# ── AI Models & Telemetry ─────────────────────────────────
# Consumed by: services/ai-engine
# The AI engine uses ChatOpenAI.
# AI_MODEL_NAME: chat model identifier (required for the graph), e.g. gpt-4o-mini
# OPENAI_API_KEY: key the engine reads (required).
# OPENAI_BASE_URL: optional OpenAI-compatible endpoint (empty = default OpenAI endpoint).
# DEEPSEEK_API_KEY: kept for reference; the engine does not read it.
AI_MODEL_NAME=gpt-4o-mini
OPENAI_API_KEY=tu_clave_openai
OPENAI_BASE_URL=
DEEPSEEK_API_KEY=tu_clave_deepseek
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=tu_clave_langsmith

# ── MCP Servers ─────────────────────────────────────────────
# Transport: HTTP with SSE (the MCP standard for remote servers).
# The *_SERVER_URL values are consumed by MCP clients (services/ai-engine) and include the
# SSE endpoint `/sse`. In Compose the host will be the service name, e.g.
# http://mcp-logs:5001/sse (private network, not published to the host).
MCP_LOGS_SERVER_URL=http://localhost:5001/sse
MCP_DB_SERVER_URL=http://localhost:5002/sse
# Listen configuration of the logs server (services/mcp-servers/logs_server):
# MCP_LOGS_HOST: 127.0.0.1 in development; 0.0.0.0 in container (set by the Dockerfile).
# MCP_LOGS_PORT: required; must match the port in MCP_LOGS_SERVER_URL.
# Local startup: MCP_LOGS_PORT=5001 python services/mcp-servers/logs_server/server.py
MCP_LOGS_HOST=127.0.0.1
MCP_LOGS_PORT=5001

# ── Docker Compose ─────────────────────────────────────────────
# docker-compose.yml reads this .env to interpolate variables and overrides what
# differs in a container: HOST=0.0.0.0, DATABASE_URL (host `postgres`) and
# MCP_LOGS_SERVER_URL (host `mcp-logs`), CORS_ALLOWED_ORIGINS and the frontend VITE_* build args.
# Required variables: DB_*, PORT, JWT_SECRET, AI_MODEL_NAME, OPENAI_API_KEY, MCP_LOGS_PORT and DOMAIN.
#   docker compose up -d --build
#   docker compose --profile tools run --rm migrate     # migrations (explicit step)
# Postgres is not published to the host (internal networks); for development access on
# 127.0.0.1:DB_PORT: docker compose -f docker-compose.yml -f docker-compose.dev-db.yml up -d

# ── Frontend (Vite) ────────────────────────────────────────────
# Consumed by: apps/frontend (exposed to the browser: never put secrets here)
# These are the DEVELOPMENT values (npm run dev, gateway on its own port). Under Docker Compose
# the frontend is built with same-origin paths instead ("/" and "/ws"); a path in
# VITE_WS_BASE_URL is resolved against the page origin (ws:// or wss:// per its protocol).
VITE_API_BASE_URL=http://localhost:8000
VITE_WS_BASE_URL=ws://localhost:8000/ws
# Vite dev server port (optional; empty = Vite default)
# Must match an origin included in the Gateway's CORS_ALLOWED_ORIGINS.
VITE_DEV_SERVER_PORT=5173
# Ticket list polling interval in ms (default 5000; 0 disables). Build-time like every VITE_* variable.
VITE_TICKETS_POLL_INTERVAL_MS=5000
#
# In a container, Vite embeds the VITE_* variables during `docker build` (not at runtime):
# they are passed as --build-arg and changing them requires rebuilding the image. They are public.
#   docker build -t autoops-frontend \
#     --build-arg VITE_API_BASE_URL=$VITE_API_BASE_URL \
#     --build-arg VITE_WS_BASE_URL=$VITE_WS_BASE_URL \
#     apps/frontend
# The container listens on port 8080 (unprivileged Nginx). Standalone, publish it with
# `-p 3000:8080` and include that origin in CORS_ALLOWED_ORIGINS.

# ── Backups (US-SYS-004) ───────────────────────────────────────
# Consumed by: scripts/ops/backup_postgres.sh and the autoops-backup units.
# BACKUP_DIR: where dumps are written (created if missing, mode 0700); keep it OUTSIDE
# the postgres_data volume. BACKUP_RETENTION_DAYS: age after which dumps are rotated.
# BACKUP_SCHEDULE: systemd OnCalendar expression for the timer.
BACKUP_DIR=/opt/autoops/backups
BACKUP_RETENTION_DAYS=7
BACKUP_SCHEDULE="*-*-* 03:00:00"

# ── Pull-based deploy (US-CICD-004) ────────────────────────────
# Consumed by: scripts/provision/70_systemd.sh, scripts/ops/deploy.sh and the autoops-deploy units.
# Optional absolute paths; defaults shown. DEPLOY_STATE_DIR holds current/previous/history/lock (0700, service user),
# DEPLOY_INBOX_DIR receives `request` from the runner, DEPLOY_OUTBOX_DIR holds `status` (read-only for the runner).
# DEPLOY_STATE_DIR=/opt/autoops/.deploy
# DEPLOY_INBOX_DIR=/opt/autoops/.deploy/inbox
# DEPLOY_OUTBOX_DIR=/opt/autoops/.deploy/outbox
# The runner (infra/runner/docker-compose.yml) bind-mounts exactly DEPLOY_INBOX_DIR (rw) and DEPLOY_OUTBOX_DIR (ro); 75_runner.sh
# resolves them with these defaults and writes them into autoops-runner.service, so a custom path only needs to be set here.
# The two read-only network checks of a deploy (GitHub compare API, registry manifests) are retried; set only to tune.
# DEPLOY_NET_RETRIES=4
# DEPLOY_NET_RETRY_DELAY=2
# Opt-in: use a classic TLS key exchange for those checks (curl --curves X25519:secp256r1, docker GODEBUG=tlsmlkem=0). Set it
# only if your network cuts the post-quantum ClientHello of recent OpenSSL/Go (see infra/deploy/README.md, "Flaky TLS").
# DEPLOY_TLS_CLASSIC_KEX=1

# ── Reverse proxy (US-PROXY-001) ───────────────────────────────
# DOMAIN: host name Traefik answers for (requests for any other Host get a 404). Required.
# PUBLIC_SCHEME: http or https; with DOMAIN it forms the public origin allowed by CORS. The proxy serves
# only HTTPS (http is redirected), so use https; it is required when TLS_MODE=acme.
# PROXY_HTTP_PORT / PROXY_HTTPS_PORT: host ports Traefik publishes for HTTP (redirect only) and HTTPS (defaults 80 / 443).
# TRAEFIK_VERSION: Traefik image tag used by infra/traefik/Dockerfile (default pinned in compose).
DOMAIN=autoops.local
PUBLIC_SCHEME=https
PROXY_HTTP_PORT=80
PROXY_HTTPS_PORT=443
#TRAEFIK_VERSION=v3.7.16

# ── TLS (US-PROXY-002) ─────────────────────────────────────────
# Read by scripts/provision/65_tls.sh and docker-compose.yml; validated by scripts/ops/validate_env.sh.
# TLS_MODE: required, no default. selfsigned = local CA signs a certificate for DOMAIN
# (provisioning creates it); acme = Let's Encrypt HTTP-01 (production).
# TLS_DIR: CA and certificate directory (default <APP_DIR>/tls; relative = under APP_DIR).
# TLS_EXTRA_SANS: extra DNS names / IPv4 addresses for the certificate, space or comma separated.
TLS_MODE=selfsigned
#TLS_DIR=
# ACME_EMAIL: Let's Encrypt account email; required when TLS_MODE=acme (also needs PUBLIC_SCHEME=https).
# ACME_CA_SERVER: empty = Let's Encrypt production. Staging: https://acme-staging-v02.api.letsencrypt.org/directory
#ACME_EMAIL=
#ACME_CA_SERVER=
# HSTS_MAX_AGE_SECONDS: Strict-Transport-Security max-age (default one year; no includeSubDomains/preload).
# EDGE_SUBNET / EDGE_TRAEFIK_IP: fixed edge_net range and Traefik's address in it. The gateway trusts X-Forwarded-For
# only from that address (uvicorn --proxy-headers), so the login rate limit sees the real client IP. Change both
# together if the range collides with another network on the host.
#HSTS_MAX_AGE_SECONDS=31536000
#EDGE_SUBNET=172.30.250.0/24
#EDGE_TRAEFIK_IP=172.30.250.2
#TLS_EXTRA_SANS=

# ── Container images (US-CICD-002) ─────────────────────────────
# Every built service is also tagged <IMAGE_REPOSITORY>/<service>:<IMAGE_TAG>. Development builds locally and
# tags autoops/<service>:dev (the defaults). The host pulls the images CI published to GHCR instead:
#   IMAGE_REPOSITORY=ghcr.io/<owner>/autoops (owner in lowercase) and IMAGE_TAG=<full commit SHA>.
# Tags are immutable commit SHAs (there is no `latest`); validate_env.sh rejects an empty or `dev` IMAGE_TAG
# when ENVIRONMENT=production.
#IMAGE_REPOSITORY=
#IMAGE_TAG=

# ── Self-hosted runner (US-CICD-003) ───────────────────────────
# Read by infra/runner/docker-compose.yml and scripts/provision/75_runner.sh (optional: the runner is only
# provisioned when RUNNER_REPO_URL is set). See infra/runner/README.md.
# RUNNER_REPO_URL: https://github.com/<owner>/<repo> the runner serves (repository-scoped).
# RUNNER_REGISTRATION_TOKEN_FILE: file with the one-hour registration token (GitHub: Settings > Actions > Runners >
# New self-hosted runner). Outside the repository, mode 0600; used only for the first start.
# RUNNER_LABELS: the ONLY labels the runner has (no self-hosted/OS/arch); workflows use `runs-on: autoops-prod`.
# RUNNER_NAME, RUNNER_VERSION / RUNNER_SHA256 (override the pin in infra/runner/Dockerfile; bump both together),
# RUNNER_CPUS, RUNNER_MEMORY_LIMIT, RUNNER_PIDS_LIMIT, RUNNER_WORKSPACE_SIZE (job workspace tmpfs).
#RUNNER_REPO_URL=
#RUNNER_REGISTRATION_TOKEN_FILE=
#RUNNER_LABELS=autoops-prod
#RUNNER_NAME=autoops-runner
#RUNNER_VERSION=
#RUNNER_SHA256=
#RUNNER_CPUS=2
#RUNNER_MEMORY_LIMIT=2g
#RUNNER_PIDS_LIMIT=512
#RUNNER_WORKSPACE_SIZE=2g
